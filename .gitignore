node_modules/
.vite/

# NOTE: dist/ is intentionally NOT gitignored. This repo commits the build
# output and Railway deploys straight from it. Vite content-hashes asset
# filenames on every build, so if dist/ were ignored, "git add -A" would
# silently skip newly-hashed JS/CSS files (they're untracked+ignored) while
# still staging deletions of the old hash-named ones — breaking the live
# site (v20.57.0 outage, 2026-09-04). Keep dist/ tracked so normal add/commit
# always picks up new build output without needing force-add.

# SQLite database files — never commit; exposes demo data at rest
data.db
data.db-shm
data.db-wal
data.db-journal

.env
.env.*
!.env.example
!.env.local.example

*.log
.DS_Store

# FREC/DBPR snapshots (runtime artifacts, not source)
dbpr_csv_snapshot.csv
frec_html_snapshot.html
